// Resources for RamRiseBalloon.exe (x86_64-w64-mingw32-windres)
#include <winuser.h>
#include <winver.h>
1 ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,3,4,0
PRODUCTVERSION 0,3,4,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041104B0"
    BEGIN
      VALUE "FileDescription", "RamRiseBalloon - RAM usage balloon while memory is rising or falling sharply"
      VALUE "FileVersion", "0.3.4.0"
      VALUE "ProductName", "RamRiseBalloon"
      VALUE "ProductVersion", "0.3.4.0"
      VALUE "OriginalFilename", "RamRiseBalloon.exe"
      VALUE "InternalName", "RamRiseBalloon"
      VALUE "LegalCopyright", "Copyright (c) 2026 zmlworks (MIT License)"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x411, 1200
  END
END
